---
// Stage 1 (exact copy): each page is written out exactly as WordPress rendered it,
// from src/data/pages.json (generated by migration/convert.py).
import pages from '../data/pages.json';

export function getStaticPaths() {
  return (pages as any[]).map((page) => ({
    params: { path: page.path.replace(/^\/|\/$/g, '') || undefined },
    props: { page },
  }));
}
const { page } = Astro.props as any;
---
<html lang={page.htmlLang}>
  <head>
    <Fragment set:html={page.head} />
  </head>
  <body class={page.bodyClass}>
    <Fragment set:html={page.body} />
  </body>
</html>
